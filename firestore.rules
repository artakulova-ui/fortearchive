rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'art.akulova@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function validItem(item) {
      return item.keys().hasAll([
          'title', 'category', 'code', 'status', 'stock',
          'size', 'description', 'images'
        ])
        && item.title is string
        && item.category is string
        && item.code is string
        && item.status in ['In Stock', 'Sold Out']
        && item.stock is int
        && item.stock >= 0
        && item.size is string
        && item.description is string
        && item.images is list
        && item.images.size() >= 1
        && item.images.size() <= 10;
    }

    match /items/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && validItem(request.resource.data);
      allow delete: if isAdmin();
    }
  }
}